# FinFlow-AI backend environment
# Copy this file to backend/.env and fill in your values (backend/.env is git-ignored).
# Loaded by all three services (agent, database, vectorstore).

# --- Google Gemini (agent-service) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# --- Supabase / PostgreSQL (database-service, vectorstore-service) ---
# Supabase dashboard -> Project Settings -> General -> Project ID
PROJECT_ID=your-supabase-project-id
# The database password you set when creating the Supabase project
PSWD=your-database-password

# Optional: full connection string. If set, it overrides PROJECT_ID/PSWD.
# The default built from PROJECT_ID/PSWD assumes the aws-1-us-east-2 pooler;
# if your project is in another region, copy the "Transaction pooler" URI from
# Supabase dashboard -> Connect, and set it here instead.
# URL-encode special characters in the password (e.g. "@" -> %40, "#" -> %23).
# SUPABASE_DB_URL=postgresql://postgres.<project-id>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- Gemini model (agent-service) ---
# Optional. Defaults to gemini-3.5-flash-lite; set this to use a different Gemini model.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Simulated "today" (database-service, agent-service) ---
# Optional. Set to the --as-of date passed to data/scripts/setup_data.py so date
# defaults and "last month" match the generated data. Leave unset to use the real date.
# FINFLOW_AS_OF_DATE=2026-04-01

# --- Internal service URLs (agent-service) ---
DATABASE_SERVICE_URL=http://localhost:8002
VECTORSTORE_SERVICE_URL=http://localhost:8001
