# Store text files with LF in the repo; check out with the platform's default
* text=auto

# Shell scripts must keep LF or bash fails on Linux/macOS ("\r: command not found")
*.sh text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
